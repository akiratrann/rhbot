# Copy to `.env` and fill in. NEVER commit the real .env file.
# You only need the section for the broker you actually use.

# --- Alpaca (RECOMMENDED — official API, stocks + crypto) ---
# Sign up at https://alpaca.markets and generate PAPER keys first. Paper keys
# are free, need no funding, and give you unlimited buys/sells against a real
# matching engine. The same two variables are used for live keys later; which
# host they hit is decided by `mode:` in config.yaml, not by the key.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Charles Schwab Trader API (LIVE MONEY ONLY) ---
# Register an app at https://developer.schwab.com and wait for approval.
# There is NO paper account on this API — every order is real. Test on Alpaca
# paper first, then point `broker: schwab` + `mode: live` here.
#
# The callback URL must EXACTLY match what you registered on the portal.
# https://127.0.0.1 is the usual choice for a local bot.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1
# Optional: pin trading to one account. Defaults to the first one returned.
SCHWAB_ACCOUNT_NUMBER=
#
# After filling the above, run `python schwab_login.py` to authorize.
# Schwab refresh tokens die after 7 DAYS, so you must re-run it weekly.
# Check remaining time with: python schwab_login.py --status

# --- Robinhood stock login (unofficial robin_stocks) ---
# Only needed for LIVE stock trading / real historical data.
RH_USERNAME=
RH_PASSWORD=
# If you use app-based MFA, put the TOTP secret here so login can auto-generate codes.
RH_MFA_SECRET=

# --- Robinhood official Crypto API ---
# Generate an API key + Ed25519 key pair in the Robinhood Crypto API dashboard.
RH_CRYPTO_API_KEY=
# Base64-encoded Ed25519 private key seed (the "private key" Robinhood gives you).
RH_CRYPTO_PRIVATE_KEY=
